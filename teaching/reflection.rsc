1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Teaching & supervision"}],["$","h1",null,{"children":"Learning from my own teaching."}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"My teaching connects academic communication, special education, and professional preparation. I design learning that moves from supported participation toward increasingly independent, evidence-informed judgment."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/teaching","aria-current":"$undefined","children":"Overview"}],["$","a","philosophy",{"href":"/teaching/philosophy","aria-current":"$undefined","children":"Teaching Philosophy"}],["$","a","iowa",{"href":"/teaching/iowa","aria-current":"$undefined","children":"Teaching at Iowa"}],["$","a","penn-state",{"href":"/teaching/penn-state","aria-current":"$undefined","children":"Teaching at Penn State"}],["$","a","schools",{"href":"/teaching/schools","aria-current":"$undefined","children":"School Experience"}],["$","a","assessment",{"href":"/teaching/assessment","aria-current":"$undefined","children":"Assessment & Planning"}],["$","a","reflection",{"href":"/teaching/reflection","aria-current":"page","children":"Reflective Practice"}]]}]}],["$","div",null,{"className":"shell","children":[false,false,false,false,false,["$","section",null,{"className":"content-section two-column","id":"reflection","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Continuing development"}],["$","h2",null,{"children":"Reflecting on my own teaching."}]]}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"I use students’ questions, their work, and feedback from supervision to reconsider my explanations, pacing, and expectations. Field supervision has also taught me the value of frequent check-ins instead of waiting until formal observations to identify a need for support."}],["$","p",null,{"children":"As I work toward the University of Iowa Certificate in College Teaching, I am using this portfolio to connect my teaching decisions with evidence of learning. My expanded review of caregiver learning also prompts a question I bring to teaching: what can a learner do with support, what can they use independently, and what makes that learning workable in practice?"}],["$","div",null,{"className":"reflection","children":[["$","strong",null,{"children":"A continuing commitment"}],["$","p",null,{"children":"Patience means maintaining clear standards while giving learners time, feedback, and repeated opportunities to improve."}]]}]]}]]}],false]}]]
