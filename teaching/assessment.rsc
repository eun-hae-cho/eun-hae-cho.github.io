"$","img",null,{"className":"profile-icon","src":"/images/social/google-scholar.svg","alt":"","width":"20","height":"20"}],["$","span",null,{"children":"Google Scholar"}]]}],["$","a",null,{"className":"footer-profile-link","href":"https://www.linkedin.com/in/eunhae-cho/","target":"_blank","rel":"noreferrer","children":[["$","img",null,{"className":"profile-icon","src":"/images/social/linkedin.svg","alt":"","width":"20","height":"20"}],["$","span",null,{"children":"LinkedIn"}]]}]]}]]}],["$","div",null,{"className":"shell footer-bottom","children":[["$","p",null,{"children":"Personal academic portfolio · University of Iowa, Iowa City"}],["$","a",null,{"href":"/resources","children":"Resources & documents"}]]}]]}]]}]}]],null],"route:/teaching/assessment/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Assessment & Planning | Eunhae Cho"}],["$","meta","1",{"name":"description","content":"Eunhae Cho, University of Iowa Special Education Ph.D. student, applied linguist, and BCBA. Research, teaching, clinical experience, Iowa LEND, and professional resources."}],["$","link","2",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","3",{"rel":"icon","href":"/favicon.svg"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"segmentMap":{"children":["teaching","assessment"]},"children":["$","$L6",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L7",null,{"children":["$","$L5",null,{"segmentMap":{"children":[]},"children":["$","$L6",null,{"id":"page:/teaching/assessment/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:bkpebwzipltx","deploymentVersion":"21bfcd11-ea38-4329-b821-2697344dc182","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Teaching & supervision"}],["$","h1",null,{"children":"Using assessment to guide instruction."}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"My teaching connects academic communication, special education, and professional preparation. I design learning that moves from supported participation toward increasingly independent, evidence-informed judgment."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/teaching","aria-current":"$undefined","children":"Overview"}],["$","a","philosophy",{"href":"/teaching/philosophy","aria-current":"$undefined","children":"Teaching Philosophy"}],["$","a","iowa",{"href":"/teaching/iowa","aria-current":"$undefined","children":"Teaching at Iowa"}],["$","a","penn-state",{"href":"/teaching/penn-state","aria-current":"$undefined","children":"Teaching at Penn State"}],["$","a","schools",{"href":"/teaching/schools","aria-current":"$undefined","children":"School Experience"}],["$","a","assessment",{"href":"/teaching/assessment","aria-current":"page","children":"Assessment & Planning"}],["$","a","reflection",{"href":"/teaching/reflection","aria-current":"$undefined","children":"Reflective Practice"}]]}]}],["$","div",null,{"className":"shell","children":[false,false,false,false,false,false,["$","section",null,{"className":"content-section","children":[["$","span",null,{"className":"status-badge","children":"Graduate coursework · EDTL 3103 · Fall 2026"}],["$","div",null,{"className":"wide-prose","children":[["$","p",null,{"children":"My coursework in Assessment, Instructional Planning, and Practice develops my ability to connect assessment evidence with instructional decisions. I am examining how brief measures, error analysis, and repeated progress monitoring can guide support while accounting for learners’ opportunities to learn, language backgrounds, and access needs."}],["$","p",null,{"children":"This work complements my preparation in special education and behavior analysis by asking what a score can tell us, what additional information is needed, and how assessment should inform the next instructional step."}]]}],["$","div",null,{"className":"grid-two","children":[["$","article",null,{"className":"info-card","children":[["$","h3",null,{"children":"Choosing evidence for the decision"}],["$","p",null,{"children":"Assessment begins with a question about learning. I distinguish curriculum-based assessments of taught content from curriculum-based measures used to sample skills and monitor progress. Screening, instructional planning, progress monitoring, and diagnostic assessment serve different purposes."}]]}],["$","article",null,{"className":"info-card","children":[["$","h3",null,{"children":"From scoring to interpretation"}],["$","p",null,{"children":"Early literacy, numeracy, and mathematics examples help me examine administration and scoring choices. Number identification, quantity discrimination, and missing-number tasks sample different skills. Reading examples add letter naming and nonsense-word fluency. Interpretation requires distinguishing rate from accuracy, comparing progress with goals, and following each measure’s scoring rules."}]]}]]}],["$","div",null,{"className":"wide-prose section-space","children":[["$","h3",null,{"children":"Connecting assessment with support"}],["$","p",null,{"children":"Within multi-tiered systems of support (MTSS), assessment informs instructional intensity. Data-based individualization connects progress monitoring, error analysis, instructional adaptation, and further monitoring. Powell and Stecker (2014) illustrate this iterative process in mathematics intervention."}],["$","p",null,{"children":"I am also developing ways to explain results clearly to families, including why an instructional-level measure may be useful without describing a learner as fixed at a particular grade or developmental level."}]]}],"$L8","$L9","$La"]}]]}]]
8:["$","div",null,{"className":"table-scroll","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Learning focus"}],["$","th",null,{"children":"Application in my preparation"}]]}]}],["$","tbody",null,{"children":[["$","tr","Assessment purpose",{"children":[["$","td",null,{"children":"Assessment purpose"}],["$","td",null,{"children":"Match the measure to the question and instructional decision."}]]}],["$","tr","Administration & scoring",{"children":[["$","td",null,{"children":"Administration & scoring"}],["$","td",null,{"children":"Follow standardized directions and identify the scoring unit."}]]}],["$","tr","Data interpretation",{"children":[["$","td",null,{"children":"Data interpretation"}],["$","td",null,{"children":"Distinguish accuracy, rate, current performance, and growth."}]]}],["$","tr","Instructional response",{"children":[["$","td",null,{"children":"Instructional response"}],["$","td",null,{"children":"Use error patterns and progress data to consider adaptations."}]]}],["$","tr","Family communication",{"children":[["$","td",null,{"children":"Family communication"}],["$","td",null,{"children":"Explain results and next steps in accessible language."}]]}],["$","tr","Fairness",{"children":[["$","td",null,{"children":"Fairness"}],["$","td",null,{"children":"Consider language, learning history, opportunity, and access."}]]}]]}]]}]}]
9:["$","div",null,{"className":"reflection","children":[["$","strong",null,{"children":"What I am learning"}],["$","p",null,{"children":"Accurate measurement is necessary, but its value depends on the decisions it supports. I want to interpret patterns across observations, consider the conditions under which learners perform, and communicate both the usefulness and the limits of the evidence."}]]}]
a:["$","div",null,{"className":"source-note","children":[["$","h3",null,{"children":"Course foundations"}],["$","p",null,{"children":"This page reflects graduate study in EDTL 3103, including CBA, CBM, MTSS, early numeracy, mathematics assessment, and data-based individualization. The instructor’s slides, lecture transcripts, assigned textbook chapters, and quizzes inform this reflection."}],["$","p",null,{"children":["Powell, S. R., & Stecker, P. M. (2014). Using data-based individualization to intensify mathematics intervention for students with disabilities. ",["$","em",null,{"children":"Teaching Exceptional Children, 46"}],"(4), 31–37. ",["$","a",null,{"className":"text-link","href":"https://doi.org/10.1177/0040059914523735","target":"_blank","rel":"noreferrer","children":"Publisher record"}]]}]]}]
