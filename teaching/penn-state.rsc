1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Teaching & supervision"}],["$","h1",null,{"children":"Academic communication & teacher education"}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"My teaching connects academic communication, special education, and professional preparation. I design learning that moves from supported participation toward increasingly independent, evidence-informed judgment."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/teaching","aria-current":"$undefined","children":"Overview"}],["$","a","philosophy",{"href":"/teaching/philosophy","aria-current":"$undefined","children":"Teaching Philosophy"}],["$","a","iowa",{"href":"/teaching/iowa","aria-current":"$undefined","children":"Teaching at Iowa"}],["$","a","penn-state",{"href":"/teaching/penn-state","aria-current":"page","children":"Teaching at Penn State"}],["$","a","schools",{"href":"/teaching/schools","aria-current":"$undefined","children":"School Experience"}],["$","a","assessment",{"href":"/teaching/assessment","aria-current":"$undefined","children":"Assessment & Planning"}],["$","a","reflection",{"href":"/teaching/reflection","aria-current":"$undefined","children":"Reflective Practice"}]]}]}],["$","div",null,{"className":"shell","children":[false,false,false,["$","section",null,{"className":"content-section","id":"penn-state","children":[["$","p",null,{"className":"eyebrow","children":"Pennsylvania State University"}],["$","h2",null,{"children":"Academic communication & language teacher education"}],["$","div",null,{"className":"detail-layout","children":[["$","div",null,{"className":"detail-meta","children":[["$","strong",null,{"children":"Graduate Instructor"}],["$","span",null,{"children":"Department of Applied Linguistics"}],["$","span",null,{"children":"2019–2024"}]]}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"In Composition for American Academic Communication II (ESL 015), I taught international undergraduates academic writing through exemplars, guided practice, feedback, and revision. This experience made the need for explicit expectations central to my teaching."}],["$","p",null,{"children":"I co-taught graduate courses in Pragmatics in Language Learning and Teaching (APLNG 585, Fall 2023) and Narrative Research in Applied Linguistics (APLNG 597, Spring 2024) with Celeste Kinginger. I also taught American Oral English for International Teaching Assistants III (ESL 118G, Summer 2024)."}],["$","p",null,{"children":"Across these settings, I learned to connect disciplinary concepts with the communicative tasks and professional situations learners encounter."}]]}]]}]]}],false,false,false]}]]
