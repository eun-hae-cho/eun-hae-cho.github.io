1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Teaching & supervision"}],["$","h1",null,{"children":"Special education & field supervision"}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"My teaching connects academic communication, special education, and professional preparation. I design learning that moves from supported participation toward increasingly independent, evidence-informed judgment."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/teaching","aria-current":"$undefined","children":"Overview"}],["$","a","philosophy",{"href":"/teaching/philosophy","aria-current":"$undefined","children":"Teaching Philosophy"}],["$","a","iowa",{"href":"/teaching/iowa","aria-current":"page","children":"Teaching at Iowa"}],["$","a","penn-state",{"href":"/teaching/penn-state","aria-current":"$undefined","children":"Teaching at Penn State"}],["$","a","schools",{"href":"/teaching/schools","aria-current":"$undefined","children":"School Experience"}],["$","a","assessment",{"href":"/teaching/assessment","aria-current":"$undefined","children":"Assessment & Planning"}],["$","a","reflection",{"href":"/teaching/reflection","aria-current":"$undefined","children":"Reflective Practice"}]]}]}],["$","div",null,{"className":"shell","children":[false,false,["$","section",null,{"className":"content-section","id":"iowa","children":[["$","p",null,{"className":"eyebrow","children":"University of Iowa"}],["$","h2",null,{"children":"Special education & field supervision"}],["$","div",null,{"className":"grid-two","children":[["$","article",null,{"className":"info-card","children":[["$","span",null,{"className":"meta","children":"EDTL 4900 · Fall 2025"}],["$","h3",null,{"children":"Foundations of Special Education"}],["$","p",null,{"children":"In a graduate teaching practicum supervised by Jillian Thoele, I led three weeks of instruction within a 15-week undergraduate course. I also supported the course as a teaching assistant during the second half of Spring 2025."}],["$","p",null,{"children":"My instruction asked students to examine common disability myths and consider how assumptions shape access, interpretations of evidence, and instructional decisions."}]]}],["$","article",null,{"className":"info-card","children":[["$","span",null,{"className":"meta","children":"University Field Supervisor · Spring 2026"}],["$","h3",null,{"children":"Supporting teacher candidates"}],["$","p",null,{"children":"I supervised four teacher candidates across four Iowa City Community School District placements, working with cooperating teachers and completing four observations per candidate."}],["$","p",null,{"children":"My responsibilities included proposal, midterm, and final meetings, written observation notes, and feedback on developing classroom practice."}]]}]]}]]}],false,false,false,false]}]]
