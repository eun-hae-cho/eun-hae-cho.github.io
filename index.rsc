9:["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"My doctoral research in applied linguistics examined language learning, educational mobility, and identity. At Iowa, I am extending this preparation through special education and applied behavior analysis, with particular attention to communication intervention and caregiver participation."}],["$","p",null,{"children":"My current research examines caregiver learning, the use of intervention in family life, and observed child communication as related but distinct concerns. Across research, teaching, and practice, I ask what support people need to learn, whether it is workable in their everyday activities, and what the evidence shows has changed."}],["$","a",null,{"className":"text-link","href":"/about","children":["Read my academic biography ",["$","$L4",null,{"ref":"$undefined","iconNode":"$1:0:props:children:0:props:children:6:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}]
