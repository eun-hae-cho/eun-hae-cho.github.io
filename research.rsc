1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Research"}],["$","h1",null,{"children":"Communication, evidence, and family context."}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"I examine how caregivers learn communication-support procedures, how those procedures fit family routines, and whether children request more independently. My research connects these distinct questions through behavioral observations, family accounts, and documented intervention decisions."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/research","aria-current":"page","children":"Overview"}],["$","a","agenda",{"href":"/research/agenda","aria-current":"$undefined","children":"Research Agenda"}],["$","a","literature-review",{"href":"/research/literature-review","aria-current":"$undefined","children":"Literature Review"}],["$","a","projects",{"href":"/research/projects","aria-current":"$undefined","children":"Projects"}],["$","a","methods",{"href":"/research/methods","aria-current":"$undefined","children":"Methods"}],["$","a","publications",{"href":"/research/publications","aria-current":"$undefined","children":"Publications"}],["$","a","presentations",{"href":"/research/presentations","aria-current":"$undefined","children":"Presentations"}]]}]}],["$","div",null,{"className":"shell","children":[["$","section",null,{"className":"content-section","children":[["$","div",null,{"className":"section-head","children":[["$","h2",null,{"children":"Current focus"}],["$","p",null,{"children":"Special education · Applied behavior analysis · Applied linguistics"}]]}],["$","div",null,{"className":"two-column","children":[["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"I focus on young autistic children with emerging requesting skills, including children who communicate through speech, gestures, signs, or augmentative and alternative communication (AAC). Independence means responding without an immediate response prompt; using AAC does not make a request nonindependent. Requesting remains one function within a broader range of meaningful communication."}],["$","p",null,{"children":"My preparation in applied linguistics contributes attention to interaction, language practices, and participants’ interpretations. Special education and behavior analysis inform my evaluation of change. Together, these perspectives support asking what caregivers need to learn, whether procedures fit family priorities, and what children do under clearly described support conditions."}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"Three connected research questions"}],["$","ol",null,{"className":"rq-list","children":[["$","li","RQ1. How does the caregiver-training and coaching package affect autistic children's independent requesting during family routines?",{"children":[["$","strong",null,{"children":["RQ",1,"."]}]," ","How does the caregiver-training and coaching package affect autistic children's independent requesting during family routines?"]}],["$","li","RQ2. How does the package affect caregivers' implementation accuracy during those routines?",{"children":[["$","strong",null,{"children":["RQ",2,"."]}]," ","How does the package affect caregivers' implementation accuracy during those routines?"]}],["$","li","RQ3. How do caregivers describe their experiences of using and adapting the procedures, and how do these accounts inform the interpretation of outcomes and intervention decisions?",{"children":[["$","strong",null,{"children":["RQ",3,"."]}]," ","How do caregivers describe their experiences of using and adapting the procedures, and how do these accounts inform the interpretation of outcomes and intervention decisions?"]}]]}],["$","a",null,{"className":"text-link","href":"/research/agenda","children":["Read the research agenda","$L8"]}]]}]]}]]}],"$L9","$La"]}]]
