1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Biography & academic background"}],["$","h1",null,{"children":"About Eunhae"}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"I am a Ph.D. student in Special Education at the University of Iowa, a Board Certified Behavior Analyst, and an applied linguist with a Ph.D. from Penn State."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/about","aria-current":"page","children":"Overview"}],["$","a","education",{"href":"/about/education","aria-current":"$undefined","children":"Education"}],["$","a","recognition",{"href":"/about/recognition","aria-current":"$undefined","children":"Recognition"}],["$","a","cv",{"href":"/about/cv","aria-current":"$undefined","children":"Curriculum vitae"}]]}]}],["$","div",null,{"className":"shell","children":[["$","section",null,{"className":"content-section two-column","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Academic biography"}],["$","h2",null,{"children":"Communication, learning, and participation in context."}]]}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"My research began with questions about how language learning is shaped by social interaction, educational opportunity, and movement across places. My Ph.D. dissertation at Penn State examined the geographic and sociocultural transitions of Korean learners of English, connecting academic literacy with identity and access."}],["$","p",null,{"children":"At Iowa, I am extending this preparation through special education and applied behavior analysis under the advising of Seth A. King. My developing research focuses on caregiver-mediated communication interventions for autistic children. I examine caregiver learning and child requesting separately, while considering how families’ priorities, existing practices, and cultural and linguistic contexts shape the use of intervention."}],["$","p",null,{"children":"My experience spans university teaching, teacher preparation, school-based supervision, and supervised clinical work. Across these settings, I ask how systematic evidence and the perspectives of learners and families can inform ethical, contextually responsive decisions."}],["$","p",null,{"children":"I aim to contribute to higher education as a researcher and educator who prepares professionals to explain their decisions, examine their assumptions, and continue learning from practice."}],["$","div",null,{"className":"actions","children":[["$","a",null,{"className":"text-link","href":"/research/agenda","children":["Explore my research agenda",["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","aria-hidden":"true"}]]}],["$","a",null,{"className":"text-link","href":"/teaching","children":["Explore my teaching",["$","$L4",null,{"ref":"$undefined","iconNode":"$1:2:props:children:0:props:children:1:props:children:4:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}]]}]]}],false,false,false]}]]
