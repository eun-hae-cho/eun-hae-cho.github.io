1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Teaching & supervision"}],["$","h1",null,{"children":"Teaching & supervision"}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"My teaching connects academic communication, special education, and professional preparation. I design learning that moves from supported participation toward increasingly independent, evidence-informed judgment."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/teaching","aria-current":"page","children":"Overview"}],["$","a","philosophy",{"href":"/teaching/philosophy","aria-current":"$undefined","children":"Teaching Philosophy"}],["$","a","iowa",{"href":"/teaching/iowa","aria-current":"$undefined","children":"Teaching at Iowa"}],["$","a","penn-state",{"href":"/teaching/penn-state","aria-current":"$undefined","children":"Teaching at Penn State"}],["$","a","schools",{"href":"/teaching/schools","aria-current":"$undefined","children":"School Experience"}],["$","a","assessment",{"href":"/teaching/assessment","aria-current":"$undefined","children":"Assessment & Planning"}],["$","a","reflection",{"href":"/teaching/reflection","aria-current":"$undefined","children":"Reflective Practice"}]]}]}],["$","div",null,{"className":"shell","children":[["$","section",null,{"className":"content-section","children":[["$","p",null,{"className":"eyebrow","children":"My approach"}],["$","h2",null,{"children":"High expectations, explicit support, and room to improve."}],["$","div",null,{"className":"wide-prose","children":[["$","p",null,{"children":"I use modeling, guided practice, feedback, reflection, and revision to make expectations visible. My experience spans elementary English, university writing, graduate co-teaching, special education, and teacher-candidate supervision."}],["$","p",null,{"childr