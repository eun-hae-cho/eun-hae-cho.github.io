1:[["$","div",null,{"className":"page-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"Research"}],["$","h1",null,{"children":"Caregiver learning and communication in family routines."}],["$","div",null,{"className":"intro-copy","children":["$","p",null,{"children":"This expanded narrative review asks how caregiver-mediated interventions support requesting and communication, and how caregiver learning needs and family experiences shape implementation and the interpretation of effectiveness. It distinguishes observed findings, interpretive synthesis, and relationships that remain to be tested."}]}]]}],["$","nav",null,{"className":"section-tabs","aria-label":"Section pages","children":["$","div",null,{"className":"shell","children":[["$","a","overview",{"href":"/research","aria-current":"$undefined","children":"Overview"}],["$","a","agenda",{"href":"/research/agenda","aria-current":"$undefined","children":"Research Agenda"}],["$","a","literature-review",{"href":"/research/literature-review","aria-current":"page","children":"Literature Review"}],["$","a","projects",{"href":"/research/projects","aria-current":"$undefined","children":"Projects"}],["$","a","methods",{"href":"/research/methods","aria-current":"$undefined","children":"Methods"}],["$","a","publications",{"href":"/research/publications","aria-current":"$undefined","children":"Publications"}],["$","a","presentations",{"href":"/research/presentations","aria-current":"$undefined","children":"Presentations"}]]}]}],["$","div",null,{"className":"shell","children":[["$","section",null,{"className":"content-section","children":[["$","div",null,{"className":"download-card","children":["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Expanded narrative review · October 26, 2026"}],["$","h2",null,{"children":"Read the full synthesis"}],["$","p",null,{"children":"The complete expanded review includes 12 pages of discussion and 4 pages of references. All 21 references are included in the preview and the full text below."}]]}]}],["$","$L8",null,{"documentId":"literature-review"}],["$","p",null,{"className":"page-note","children":"This focused narrative synthesis centers on four studies of caregiver-mediated communication, supported by caregiver-learning, family-experience, and methodological literature. It is distinct from my ongoing collaborative systematic review and does not report findings from my proposed intervention."}],["$","h2",null,{"children":"What the literature contributes"}],["$","div",null,{"className":"grid-two","children":[["$","article","Caregiver learning and child change are distinct",{"className":"info-card","children":[["$","h3",null,{"children":"Caregiver learning and child change are distinct"}],["$","p",null,{"children":"Caregivers can acquire procedures while children show different patterns of change. Independent requesting needs its own evidence; neither accurate implementation nor broader communication-act frequency can stand in for that outcome."}],["$","p",null,{"className":"meta","children":"Suberman & Cividini-Motta, 2020; McCammon et al., 2022; Whalon et al., 2026"}]]}],["$","article","Existing practices inform learning support",{"className":"info-card","children":[["$","h3",null,{"children":"Existing practices inform learning support"}],["$","p",null,{"children":"Caregivers begin with different skills and experiences. Rehearsal, feedback, and booster instruction can be examined in relation to those needs. An association between practice with feedback and strategy use does not isolate feedback’s causal effect."}],["$","p",null,{"className":"meta","children":"Sone et al., 2021, 2023; Roberts et al., 2023; Ampuero & Courtenay, 2026"}]]}],["$","article","Learning a procedure and using it in family life differ",{"className":"info-card","children":[["$","h3",null,{"children":"Learning a procedure and using it in family life differ"}],["$","p",null,{"children":"Difficulty performing a skill may call for instruction; difficulty fitting it into daily life may call for reconsidering timing, targets, materials, or expectations. Accurate implementation can coexist with burden or disagreement about an intervention’s value."}],"$L9"]}],"$La","$Lb","$Lc"]}]]}],"$Ld"]}]]
9:["$","p",null,{"className":"meta","children":"Whalon et al., 2026; Leko, 2014"}]
a:["$","article","Support and opportunities shape interpretation",{"className":"info-card","children":[["$","h3",null,{"children":"Support and opportunities shape interpretation"}],["$","p",null,{"children":"Coach fidelity, caregiver accuracy, and child communication describe different levels of evidence. Step-specific performance, available opportunities, prompting, and coaching conditions help clarify what each outcome means."}],["$","p",null,{"className":"meta","children":"Elmquist et al., 2025; McCammon et al., 2022; Gevarter et al., 2022"}]]}]
b:["$","article","Transfer and broader communication need separate evidence",{"className":"info-card","children":[["$","h3",null,{"children":"Transfer and broader communication need separate evidence"}],["$","p",null,{"children":"A request through speech, gesture, sign, or AAC can be independent. Gains in a trained routine do not establish transfer, maintenance, or change in other communicative functions; each requires evidence suited to that question."}],["$","p",null,{"className":"meta","children":"Gevarter et al., 2022; Whalon et al., 2026; Sandbank et al., 2023"}]]}]
c:["$","article","Family perspectives can inform decisions during intervention",{"className":"info-card","children":[["$","h3",null,{"children":"Family perspectives can inform decisions during intervention"}],["$","p",null,{"children":"Collecting feedback and documenting how it informs a decision are different tasks. Linking accounts, observations, adaptations, and the rationale available at the time makes interpretation traceable while preserving disagreement and uncertainty."}],["$","p",null,{"className":"meta","children":"Whalon et al., 2026; Love et al., 2023; Wiltsey Stirman et al., 2019"}]]}]
d:["$","section",null,{"className":"content-section","children":["$","article",null,{"className":"article-text","aria-label":"Complete original document","children":[["$","h2","0",{"children":"Caregiver Learning and Communication in Family Routines"}],["$","p","1",{"className":"document-meta","children":"Eunhae Cho | University of Iowa | EALL 7475"}],["$","p","2",{"className":"$undefined","children":[["$","span","0",{"children":"Caregiver-mediated communication interventions can strengthen adults' use of instructional strategies and support children's communication, but these outcomes do not necessarily improve together. Roberts et al. (2019), synthesizing 76 studies, found positive associations between parent training and caregiver and child outcomes. Their review included diverse populations and excluded studies with fewer than ten participants; it therefore supports caregiver involvement broadly rather than establishing the effects of particular mand-training procedures. More targeted studies document variable child responses despite improved caregiver implementation (McCammon et al., 2022; Suberman & Cividini-Motta, 2020)."}]]}],["$","p","3",{"className":"$undefined","children":[["$","span","0",{"children":"This review asks how caregiver-mediated interventions influence functional requesting and independent communication among autistic children with emerging communication, and how caregivers' learning needs and family experiences shape implementation and the interpretation of effectiveness. Its central argument is that instructional learning, use within family life, and child communication are related but distinct. Caregiver learning needs concern the support required to understand and use procedures; family experiences help explain whether those procedures fit caregivers' priorities and daily interactions. Neither can substitute for direct evidence of child change."}]]}],["$","p","4",{"className":"$undefined","children":[["$","span","0",{"children":"This is a focused narrative review, not an exhaustive systematic review or a new analysis of participant data. Four studies anchor the comparison: Suberman and Cividini-Motta (2020), McCammon et al. (2022), Gevarter et al. (2022), and Whalon et al. (2026). Additional syntheses, caregiver-learning studies, and qualitative and methodological literature clarify their implications. The review distinguishes study findings from the interpretive connections proposed here and from questions that require further investigation."}]]}],["$","h3","5",{"children":"Research Questions and Conceptual Boundaries"}],["$","p","6",{"className":"$undefined","children":[["$","span","0",{"children":"Three questions for my proposed study organize the review. They concern a caregiver-training and coaching package supporting children aged three to five during family routines; the literature informs these questions without providing results for the proposed package."}]]}],["$","p","7",{"className":"research-question","children":[["$","strong",null,{"children":"RQ1."}]," How does the caregiver-training and coaching package affect autistic children's independent requesting during family routines?"]}],["$","p","8",{"className":"research-question","children":[["$","strong",null,{"children":"RQ2."}]," How does the package affect caregivers' implementation accuracy during those routines?"]}],["$","p","9",{"className":"research-question","children":[["$","strong",null,{"children":"RQ3."}]," How do caregivers describe their experiences of using and adapting the procedures, and how do these accounts inform the interpretation of outcomes and intervention decisions?"]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c"]}]}]
e:["$","p","10",{"className":"$undefined","children":[["$","span","0",{"children":"Skinner's (1957) functional account defines a mand through its relation to motivating conditions and a characteristic consequence mediated by another person. A spoken word, gesture, manual sign, or device selection may serve as a request; its form alone does not establish its function. The proposed outcome concerns requests for access, assistance, and continuation, rather than speech production alone."}]]}]
f:["$","p","11",{"className":"$undefined","children":[["$","span","0",{"children":"Functional requesting and independent communication are not interchangeable. Requesting is one communicative function, whereas broader communication measures may include commenting, refusing, or sharing attention. Independence concerns responding without an immediate response prompt, not communicating without AAC or a responsive partner. Likewise, an unprompted request within a familiar teaching arrangement does not establish generalization across activities or partners. These distinctions matter because the focal studies measure different outcomes, from independent mands to broader communication acts (Suberman & Cividini-Motta, 2020; Whalon et al., 2026). The review therefore retains independent requesting as its primary child outcome without treating it as the whole of meaningful communication."}]]}]
10:["$","h3","12",{"children":"Caregiver Training and Child Requesting"}]
11:["$","p","13",{"className":"$undefined","children":[["$","span","0",{"children":"Suberman and Cividini-Motta (2020) used behavioral skills training (BST) to teach caregivers mand-training procedures with speech-generating devices. Ampuero and Courtenay (2026) classify the caregiver evaluation as a nonconcurrent multiple-baseline design. Caregivers acquired the procedures, and independent child requests increased between pretraining and posttraining observations for two of three children. This provides directly relevant evidence for aided requesting, but caregiver experimental outcomes and child pre/post observations support different inferences. The latter do not independently demonstrate a functional relation for child communication."}]]}]
12:["$","p","14",{"className":"$undefined","children":[["$","span","0",{"children":"McCammon et al. (2022) evaluated POWER using a nonconcurrent multiple-baseline design across three mother-child dyads. Mothers viewed a brief narrated video with onscreen text before conducting vocal mand training during home play. All improved implementation, although one did not reach mastery; child gains were smaller and variable. Eligibility required an echoic repertoire, limiting application to children without those skills. Follow-up was included, but transfer to new routines was not assessed. Researchers attended sessions and retained research materials between visits, so home-based performance did not establish unsupported implementation throughout daily life."}]]}]
13:["$","p","15",{"className":"$undefined","children":[["$","span","0",{"children":"The authors' correction distinguishes Douglas and colleagues' communication-partner intervention from mand training, retracts criticism of its lack of prompting, and acknowledges POWER's structural similarity to the earlier POWR strategy. It does not alter the reported core findings (McCammon et al., 2026). This distinction cautions against evaluating differently purposed interventions as though they shared identical requirements."}]]}]
14:["$","p","16",{"className":"$undefined","children":[["$","span","0",{"children":"Together, the two focal studies support caregiver acquisition under specified conditions, not the superiority of one training format. Differences in participants, modalities, and procedures prevent a direct BST-versus-video comparison. More importantly, adult improvement does not resolve RQ1: children still require separate evaluation, even when caregivers learn the procedures targeted by RQ2."}]]}]
15:["$","h3","17",{"children":"Caregiver Learning Needs"}]
16:["$","p","18",{"className":"$undefined","children":[["$","span","0",{"children":"Caregiver learning needs are treated here as requirements for understanding procedures, practicing them accurately, recognizing children's communication, and deciding when additional support is needed. This is an organizing interpretation, not a validated classification. It shifts attention from whether caregivers completed training to what they learned and under which support conditions they can use it."}]]}]
17:["$","p","19",{"className":"$undefined","children":[["$","span","0",{"children":"Ampuero and Courtenay's (2026) review of 14 single-case BST studies classified ten as producing positive caregiver outcomes, including four that reached that classification after booster training. Only three examined generalization beyond the training context. The samples extended beyond preschool children. These findings make additional support part of the explanation of learning rather than an incidental detail; mastery after boosters does not demonstrate that initial instruction was sufficient."}]]}]
18:["$","p","20",{"className":"$undefined","children":[["$","span","0",{"children":"Sone et al. (2021) found an advantage for coaching over traditional instruction on caregiver outcomes across seven early-intervention studies. In a separate analysis, parent practice with feedback was associated with increased strategy use (Sone et al., 2023). These findings support examining opportunities for practice and correction, but neither warrants assuming that more coaching necessarily produces greater child requesting. The latter association does not isolate feedback as a causal component."}]]}]
19:["$","p","21",{"className":"$undefined","children":[["$","span","0",{"children":"Roberts et al. (2023), in a randomized trial involving 119 mothers and autistic children, found greater postintervention use of taught responsive than directive strategies. Their findings also implicated preintervention strategy use in understanding individual differences. This suggests assessing existing practices rather than treating every caregiver as a novice. For RQ2, relevant questions include which steps require rehearsal, whether multimodal communication is recognized, and whether support remains necessary after instruction. A caregiver's difficulty using a procedure may reflect instructional needs, competing demands, or disagreement with its purpose; those possibilities require different responses rather than a single judgment of poor compliance."}]]}]
1a:["$","h3","22",{"children":"Communication Support in Family Activities"}]
1b:["$","p","23",{"className":"$undefined","children":[["$","span","0",{"children":"Gevarter et al. (2022) studied naturalistic communication instruction in family-selected routines using a nonconcurrent multiple-probe design across three provider-parent-child triads. Children had autism or early signs of autism, and targets included gestures and manual signs. Planning, visual supports, video modeling, and coaching formed a multicomponent package. Communication turns and independent child responses increased with differing trajectories, and parent performance remained above baseline as assistance faded. The study connects instruction to family activities while extending communication beyond vocal requests. Its package design does not isolate coaching or routine selection as the cause of change."}]]}]
1c:["$","p","24",{"className":"$undefined","children":[["$","span","0",{"children":"Open-ended caregiver feedback documented implementation difficulties, demonstrating that family perspectives already contribute to this literature. Participants were English-proficient Latinx caregivers; the study does not establish equivalent results for coaching in other home languages (Gevarter et al., 2022). Selecting a familiar routine is also not evidence of generalization. Transfer must be assessed in activities or with partners beyond the original teaching arrangement."}]]}]
1d:["$","p","25",{"className":"$undefined","children":[["$","span","0",{"children":"Whalon et al. (2026) examined Read MORe during shared reading with three autistic children aged four to six using visual scene display AAC. Their convergent mixed-methods design combined repeated observations, interviews, and weekly coaching reflections. All parents increased strategy use; two children increased communication-act frequency, whereas the third already communicated frequently in baseline. Scheduling difficulties resulted in nonconcurrent baselines, and one dyad did not complete maintenance. These conditions qualify conclusions about replicated change and durability."}]]}]
1e:["$","p","26",{"className":"$undefined","children":[["$","span","0",{"children":"Shared-reading communication acts are not equivalent to independent functional requests, and strategy frequency is not implementation accuracy. Thus, Whalon et al. (2026) offer a particularly relevant example of integration for RQ3 without supplying a direct experimental answer to RQ1 or RQ2 as defined here. The studies complement one another through different outcomes and settings rather than interchangeable demonstrations of effectiveness."}]]}]
1f:["$","h3","27",{"children":"Family Experience and Intervention Use"}]
20:["$","p","28",{"className":"$undefined","children":[["$","span","0",{"children":"Whalon et al. (2026) show why increased strategy use does not necessarily mean that an intervention matches family expectations. Two parents interpreted AAC displays as supporting interaction, while one viewed them as interfering and questioned the appropriateness of some strategies. Parents differed in their emphasis on following the child's lead or obtaining correct responses. Busy schedules and other daily circumstances also affected participation. These accounts identify differences in the meaning and use of intervention; they do not prove that particular beliefs caused particular child outcomes."}]]}]
21:["$","p","29",{"className":"$undefined","children":[["$","span","0",{"children":"Leroux et al. (2024) interviewed 37 parents of elementary-age children with complex communication needs three times during the pandemic school year. They identified similarities and differences in goals, perceptions of parental roles, and satisfaction with supports and progress. Because the sample was older and the setting pandemic-specific, this study is contextual rather than direct evidence about preschool mand training. It nevertheless shows why a shared interest in communication should not be mistaken for agreement about priorities, responsibilities, or acceptable intervention demands."}]]}]
22:["$","p","30",{"className":"$undefined","children":[["$","span","0",{"children":"Social validity gives these judgments a distinct evidential role. Leko (2014), studying a reading intervention with teachers, illustrates how practical considerations interact in evaluations of acceptability. Applied cautiously to the caregiver literature, this perspective supports examining concrete experiences rather than relying only on favorable ratings. A parent may demonstrate accurate implementation yet find the routine burdensome, or value shared enjoyment despite limited change on a requesting measure."}]]}]
23:["$","p","31",{"className":"$undefined","children":[["$","span","0",{"children":"The implication for RQ3 is to distinguish difficulty performing a skill from difficulty incorporating it into family life. Repeated coaching may address the former; the latter may call for reconsidering timing, targets, materials, or expectations. Caregiver accounts can guide those decisions without making families responsible for explaining every limited child gain. Family endorsement also should not replace attention to the child's engagement and refusal."}]]}]
24:["$","h3","32",{"children":"Interpreting Implementation and Child Outcomes"}]
25:["$","p","33",{"className":"$undefined","children":[["$","span","0",{"children":"Caregiver performance must be interpreted in relation to the assistance available. Elmquist et al. (2025) reviewed caregiver-implemented AAC interventions and identified limited caregiver-dependent measures and underrepresentation of marginalized families. Their review supports closer attention to how caregivers learn and implement AAC procedures, rather than treating child data as a sufficient account of the intervention. Supported practice and observations without live coaching answer different questions; success during the former cannot establish the latter."}]]}]
26:["$","p","34",{"className":"$undefined","children":[["$","span","0",{"children":"Three levels of evidence should therefore remain distinct: whether the professional delivered the intended support, whether the caregiver used the procedures accurately, and whether the child communicated more independently. A coach-fidelity score does not measure caregiver learning. Likewise, a composite caregiver-accuracy score can conceal differences in waiting, prompting, or responding to communication. Equal overall accuracy need not mean that children encountered equivalent opportunities or consequences (McCammon et al., 2022)."}]]}]
27:["$","p","35",{"className":"$undefined","children":[["$","span","0",{"children":"Sandbank et al.'s (2023) updated Project AIM synthesis, covering 252 controlled group studies, found smaller effects for distal and generalized than proximal and context-bound outcomes, with conclusions sensitive to risk-of-bias restrictions. This is neither caregiver-specific nor a direct evaluation of mand training. Its contribution is to caution against extending a narrow observed gain into a claim about communication across contexts. Maintaining a skill, transferring it to another routine, and acquiring broader communication functions require separate evidence."}]]}]
28:["$","p","36",{"className":"$undefined","children":[["$","strong","0",{"children":"For RQ1, "}],["$","span","1",{"children":"recording opportunities alongside independent requests would help interpret change. A higher request count might reflect more available opportunities, a greater proportion of independent responses, or both. This is a measurement implication, not a finding that opportunity frequency explains all child differences. For RQ2, reporting support and step-specific performance would clarify what an accuracy score means. Both measures remain necessary when judging whether a family-centered package achieved its intended outcomes."}]]}]
29:["$","h3","37",{"children":"Mixed Methods and Adaptation"}]
2a:["$","p","38",{"className":"$undefined","children":[["$","span","0",{"children":"Qualitative description offers a way to examine experiences closely in participants' terms (Sandelowski, 2000). Analysis should preserve differing and ambivalent accounts, distinguish participants' explanations from researchers' interpretations, and consider how the coach-researcher relationship shapes disclosure. Caregiver reports of use outside recorded sessions are meaningful accounts, but they are not equivalent to direct observations of generalization."}]]}]
2b:["$","p","39",{"className":"$undefined","children":[["$","span","0",{"children":"Corr et al. (2021) identified limited reporting of recommended mixed-methods components in special education. Leko et al. (2023) provide quality indicators, while Love et al. (2023) emphasize specifying what is integrated, when integration occurs, and the relative emphasis of each approach. Together, these sources support a design in which qualitative analysis contributes more than favorable quotations appended to behavioral graphs."}]]}]
2c:["$","p","40",{"className":"$undefined","children":[["$","span","0",{"children":"Joint displays can align quantitative observations with qualitative findings and enable examination of agreement, elaboration, and divergence (Fetters et al., 2013). Whalon et al. (2026) collected reflections throughout intervention but located formal integration at the end. This distinguishes obtaining ongoing family feedback from documenting its use in decisions during intervention. For RQ3, a record linking the information available, the decision made, and subsequent observations would make that process traceable."}]]}]
2d:["$","p","41",{"className":"$undefined","children":[["$","span","0",{"children":"Adaptations also require specification. The FRAME identifies what changed, when, why, who participated, and whether modifications preserved intervention fidelity (Wiltsey Stirman et al., 2019). Changing an activity or communication form while retaining core procedures differs from altering the procedures themselves. Recording these differences prevents all departures from being labeled either failure or appropriate tailoring. It also prevents later explanations from being mistaken for the reasons originally guiding decisions. Such records clarify implementation; they do not establish that an adaptation caused improvement. Experimental evidence remains necessary for causal claims, and concurrent changes in services or routines must remain visible in interpretation."}]]}]
2e:["$","h3","42",{"children":"Synthesis and Research Positioning"}]
2f:["$","p","43",{"className":"$undefined","children":[["$","span","0",{"children":"The literature supports a conditional, rather than automatic, connection between caregiver intervention and child communication. Instruction can expand caregivers' skills; those skills may alter the opportunities and responses children encounter; family priorities and practical conditions influence how procedures are used. This is an interpretive synthesis of the reviewed findings, not a demonstrated mediation model. It explains why caregiver acquisition, everyday implementation, and child outcomes must be examined together without collapsing them into one indicator of success."}]]}]
30:["$","p","44",{"className":"$undefined","children":[["$","span","0",{"children":"First, evidence for caregiver learning is often clearer than evidence for corresponding child change. BST and video-based instruction establish that caregivers can acquire procedures, but the focal mand-training studies do not show uniform improvements in independent requesting (McCammon et al., 2022; Suberman & Cividini-Motta, 2020). High implementation accuracy therefore does not justify assuming that a child's communication needs have been met. Target fit, available opportunities, modality, and continued prompting remain questions to examine, not established explanations for a particular child's response."}]]}]
31:["$","p","45",{"className":"$undefined","children":[["$","span","0",{"children":"Second, learning needs and family experiences interact but are not synonymous. Knowing how to wait or model a response is different from finding those actions meaningful and workable in a recurring activity. Whalon et al. (2026) show that improved strategy use can coexist with divergent judgments about appropriateness. Combined with evidence on caregiver instruction, this supports examining both learning support and the acceptability of what is being taught, rather than prescribing additional training whenever implementation is inconsistent."}]]}]
32:["$","p","46",{"className":"$undefined","children":[["$","span","0",{"children":"Third, family accounts can change the interpretation of effectiveness. Observed gains alongside reported burden indicate benefits with constraints; favorable experiences alongside limited requesting may identify valued outcomes outside the primary measure. These are possible interpretations to test against contextualized data, not reasons to dismiss either source. The resulting synthesis should state what improved, for whom, under which conditions, and what remains uncertain."}]]}]
33:["$","p","47",{"className":"$undefined","children":[["$","strong","0",{"children":"For RQ1, "}],["$","span","1",{"children":"the reviewed evidence justifies evaluating independent requesting across individualized modalities, while retaining clear functional and prompting criteria. My proposed study would extend the mand-training literature through repeated measures in family routines and descriptive assessment of maintenance and transfer. It would not treat increased requesting as evidence that all communication functions improved. The contribution is a bounded evaluation of an intervention package, not a claim that one approach benefits every autistic child."}]]}]
34:["$","p","48",{"className":"$undefined","children":[["$","strong","0",{"children":"For RQ2, "}],["$","span","1",{"children":"the literature supports examining caregiver accuracy separately and interpreting it alongside the amount and type of support provided. I would build on BST and video-based studies by distinguishing uncoached probes from supported practice and documenting booster instruction and adaptations. Existing practices would inform coaching priorities rather than assuming identical learning needs. Any demonstrated functional relation would concern the package; the separate effects of video modeling, feedback, and collaborative planning would require further investigation."}]]}]
35:["$","p","49",{"className":"$undefined","children":[["$","strong","0",{"children":"For RQ3, "}],["$","span","1",{"children":"family-selected routines, open-ended feedback, and mixed-methods shared-reading research already establish a foundation for examining family perspectives. My study would complement this work by linking caregiver accounts, behavioral observations, and dated intervention decisions during implementation as well as at final interpretation. Qualitative description and joint displays would help explain why similar measured gains can have different practical meanings, while retaining disagreement and distinguishing prospective decisions from retrospective explanations."}]]}]
36:["$","p","50",{"className":"$undefined","children":[["$","span","0",{"children":"Overall, caregiver-mediated interventions can support functional requesting by helping familiar adults provide relevant communication opportunities and responses. Their value depends on more than adults completing procedures correctly: the procedures must also be interpreted in relation to children's observed communication and families' experiences of using them. Caregiver learning needs identify where instructional support may be necessary; family accounts clarify priorities, feasibility, and choices. Examining these dimensions together offers a stronger answer to the review's overarching question without claiming that their causal relationships have already been established."}]]}]
