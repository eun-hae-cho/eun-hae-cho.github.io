0:{"__route":"route:/research/literature-review/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/research/literature-review/":"$L1","layout:/":[[[["$","link","css:/assets/index-DbdD1qPM.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DbdD1qPM.css","data-rsc-css-href":"/assets/index-DbdD1qPM.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","$L2",null,{}],["$","main",null,{"id":"main-content","tabIndex":-1,"children":["$","$L3",null,{}]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"className":"shell footer-main","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Eunhae Cho"}],["$","h2",null,{"children":"Let’s stay in conversation!"}],["$","p",null,{"children":"Special Education · Applied Linguistics · Applied Behavior Analysis"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"className":"footer-profile-link","href":"mailto:eunhaecho@uiowa.edu","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7","key":"132q7q"}],["rect",{"x":"2","y":"4","width":"20","height":"16","rx":"2","key":"izxlao"}]],"className":"lucide-mail profile-icon","aria-hidden":"true","width":20,"height":20}],["$","span",null,{"children":"eunhaecho@uiowa.edu"}]]}],["$","a",null,{"className":"footer-profile-link","href":"https://orcid.org/0000-0001-5391-0436","target":"_blank","rel":"noreferrer","children":[["$","img",null,{"className":"profile-icon","src":"/images/social/orcid.svg","alt":"","width":"20","height":"20"}],["$","span",null,{"children":"ORCID: 0000-0001-5391-0436"}]]}],["$","a",null,{"className":"footer-profile-link","href":"https://scholar.google.com/citations?user=0yUE92oAAAAJ","target":"_blank","rel":"noreferrer","children":[["$","img",null,{"className":"profile-icon","src":"/images/social/google-scholar.svg","alt":"","width":"20","height":"20"}],["$","span",null,{"children":"Google Scholar"}]]}],["$","a",null,{"className":"footer-profile-link","href":"https://www.linkedin.com/in/eunhae-cho/","target":"_blank","rel":"noreferrer","children":[["$","img",null,{"className":"profile-icon","src":"/images/social/linkedin.svg","alt":"","width":"20","height":"20"}],["$","span",null,{"children":"LinkedIn"}]]}]]}]]}],["$","div",null,{"className":"shell footer-bottom","children":[["$","p",null,{"children":"Personal academic portfolio · University of Iowa, Iowa City"}],["$","a",null,{"href":"/resources","children":"Resources & documents"}]]}]]}]]}]}]],null],"route:/research/literature-review/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Literature Review | Eunhae Cho"}],["$","meta","1",{"name":"description","content":"Eunhae Cho, University of Iowa Special Education Ph.D. student, applied linguist, and BCBA. Research, teaching, clinical experience, Iowa LEND, and professional resources."}],["$","link","2",{"rel":"shortcut icon","href":"/favicon.svg?v=iowa-20261108"}],["$","link","3",{"rel":"icon","href":"/favicon.svg?v=iowa-20261108"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"segmentMap":{"children":["research","literature-review"]},"children":["$","$L6",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L7",null,{"children":["$","$L5",null,{"segmentMap":{"children":[]},"children":["$","$L6",null,{"id":"page:/research/literature-review/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1vs49q447gwzw","deploymentVersion":"21bfcd11-ea38-4329-b821-2697344dc182","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
