1e:["$","section",null,{"className":"content-section","children":[["$","h2",null,{"children":"Next directions"}],["$","div",null,{"className":"grid-two","children":[["$","article",null,{"className":"info-card","children":[["$","h3",null,{"children":"Communication, language, and family priorities"}],["$","p",null,{"children":"Future projects will examine how communication modalities, home languages, existing caregiver practices, and family priorities shape goal selection and coaching. Broader communicative functions remain directions for subsequent studies, rather than additional primary outcomes of the proposed requesting study."}]]}],["$","article",null,{"className":"info-card","children":[["$","h3",null,{"children":"Preparing educators to interpret evidence"}],["$","p",null,{"children":"I aim to examine how special educators learn to distinguish instructional support needs from difficulties fitting a procedure into daily life, collaborate with families, and interpret behavioral and experiential evidence without treating them as interchangeable."}]]}]]}]]}]
